RATE_LIMITING_ENABLE=false
RATE_LIMITING_FREQUENCY=2/3seconds

# Response caching
CACHE_ENABLE=true
CACHE_MAX_ENTRIES=2000
CACHE_STALE_SECONDS=604800
CACHE_NEGATIVE_TTL=300
CACHE_TTL_SHORT=21600
CACHE_TTL_MEDIUM=43200
CACHE_TTL_LONG=86400
CACHE_TTL_ARCHIVE=2592000

# Bot challenge circuit breaker
BOT_BREAKER_ENABLE=true
BOT_BREAKER_THRESHOLD=3
BOT_BREAKER_COOLDOWN=60
